# ── App ────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=*

# ── Database ───────────────────────────────────────
DATABASE_URL=postgresql://besafe:besafe@localhost:5432/besafe
DATABASE_POOL_MAX=10

# ── Redis (sockets, rate limit, circuit breaker cache) ──
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-prod-please-32-chars-min
JWT_REFRESH_SECRET=change-me-too-refresh-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SEC=300
OTP_LENGTH=6
SOS_PIN_MIN_LENGTH=4

# ── Mono (identity — NIN/BVN) ──────────────────────
MONO_BASE_URL=https://api.withmono.com
MONO_SECRET_KEY=sk_test_replace_me
MONO_PUBLIC_KEY=pk_test_replace_me
MONO_TIMEOUT_MS=15000

# ── VerifyMe (driver's license, FRSC) ──────────────
VERIFYME_BASE_URL=https://api.verified.africa
VERIFYME_USER_ID=your-verifyme-user-id
VERIFYME_API_KEY=your-verifyme-api-key
VERIFYME_TIMEOUT_MS=15000

# ── Twilio (OTP SMS + emergency contact notifications) ──
TWILIO_ACCOUNT_SID=ACxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxx
TWILIO_FROM_NUMBER=+15005550006
TWILIO_TIMEOUT_MS=10000

# ── Lagos State Government feed (optional integration) ──
LSG_WEBHOOK_URL=
LSG_WEBHOOK_SECRET=

# ── Feature flags ──────────────────────────────────
FEATURE_STUB_IDENTITY_PROVIDERS=true   # true = don't hit real providers, return mock data
FEATURE_STUB_SMS=true                  # true = log OTPs to console instead of sending SMS
